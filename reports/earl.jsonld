        {
          "@id": "https://w3c.github.io/json-ld-api/tests/expand-manifest#tes01",
          "@type": [
            "https://w3c.github.io/json-ld-api/tests/vocab#NegativeEvaluationTest",
            "https://w3c.github.io/json-ld-api/tests/vocab#ExpandTest",
            "TestCriterion",
            "TestCase"
          ],
          "title": "Using an array value for @context is illegal in JSON-LD 1.0",
          "rdfs:comment": "Verifies that an exception is raised on expansion when a invalid container mapping is found",
          "testAction": "https://w3c.github.io/json-ld-api/tests/expand/es01-in.jsonld",
          "mf:result": "invalid container mapping",
          "https://w3c.github.io/json-ld-api/tests/vocab#option": {
            "@id": "_:b292",
            "https://w3c.github.io/json-ld-api/tests/vocab#processingMode": "json-ld-1.0",
            "https://w3c.github.io/json-ld-api/tests/vocab#specVersion": "json-ld-1.1"
          },
